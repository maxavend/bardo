---
import Layout from "@/layouts/main.astro"
import "@/styles/pages.css"
import DownloadButton from "@/components/site/DownloadButton.astro"
import Shot from "@/components/site/Shot.astro"
import { links, url } from "@/lib/site"

const steps = [
  { title: "Arrastra Bardo a Aplicaciones", text: "Abre el archivo <code>.dmg</code> y suelta el ícono en la carpeta." },
  { title: "Ábrelo una vez", text: "macOS lo bloquea la primera vez porque aún no está notarizado." },
  { title: "Permite que se abra", text: "En Ajustes del Sistema &rsaquo; Privacidad y seguridad, elige «Abrir de todos modos»." },
]

const sizes = [
  { name: "Rápido", value: "Sin descarga, con macOS 26 o posterior" },
  { name: "Equilibrado", value: "646 MB" },
  { name: "Preciso", value: "3,1 GB" },
  { name: "Hablantes", value: "11 MB, con cualquiera" },
]
---

<Layout
  title="Descargar Bardo"
  description="Descarga Bardo para Mac con Apple silicon y macOS 15 o posterior: cómo instalarlo y abrirlo la primera vez."
  current="descargar"
>
  <section class="pt-24 pb-16 max-lg:pt-16" aria-labelledby="page-title">
    <div class="shell grid grid-cols-[auto_minmax(0,1fr)] items-center gap-24 max-lg:grid-cols-1 max-lg:gap-6">
      <img class="size-50 max-lg:size-30" src={url("assets/marca/icono-bardo.webp")} width="320" height="320" alt="Ícono de Bardo" />
      <div class="flex flex-col items-start gap-6">
        <h1 id="page-title" class="text-display">Descargar Bardo</h1>
        <p class="max-w-[52ch] text-lead text-ink-2">Gratis, para Mac con Apple silicon y macOS 15 o posterior.</p>
        <div class="flex flex-wrap items-center gap-6 pt-2">
          <DownloadButton label="Descargar el DMG" />
          <a class="text-link" href={links.releases}
            >Ver todas las versiones</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="pt-16" aria-labelledby="install-title">
    <div class="shell flex flex-col gap-16">
      <h2 id="install-title" class="text-section">Instalar en tres pasos</h2>
      <ol class="grid grid-cols-3 gap-8 max-lg:grid-cols-1">
        {
          steps.map((step, i) => (
            <li class="flex min-h-65 flex-col gap-3 border-t-[1.5px] border-primary pt-6 max-lg:min-h-0">
              <span class="font-display text-display-s text-primary" aria-hidden="true">{i + 1}</span>
              <h3 class="text-title">{step.title}</h3>
              <p class="text-ink-2" set:html={step.text} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="pt-36 max-lg:pt-24" aria-labelledby="first-title">
    <div class="shell grid grid-cols-[minmax(0,6fr)_minmax(0,5fr)] items-center gap-24 max-lg:grid-cols-1 max-lg:gap-10">
      <Shot
        src="assets/capturas/elegir-transcripcion.webp"
        width={1400}
        height={1152}
        alt="Bardo pregunta cómo transcribir: Rápido, Equilibrado o Preciso"
        slotName="elegir"
        slotAlt="La pantalla Elige cómo transcribir, con Rápido, Equilibrado y Preciso"
        class="aspect-[1400/1152]"
      />
      <div class="flex flex-col gap-10">
        <h2 id="first-title" class="text-section">Cuánto ocupa cada opción</h2>
        <dl class="border-t-[1.5px] border-primary">
          {
            sizes.map((size) => (
              <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] items-baseline gap-8 border-b py-4">
                <dt class="font-display text-2xl">{size.name}</dt>
                <dd class="text-ink-2">{size.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="text-sm text-ink-muted">Puedes cambiar de opción cuando quieras, en Ajustes.</p>
      </div>
    </div>
  </section>

  <section class="mt-36 bg-paper-2 py-30 text-ink max-lg:mt-24 max-lg:py-20" aria-labelledby="verify-title">
    <div class="shell grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-center gap-8 max-lg:grid-cols-1">
      <h2 id="verify-title" class="text-3xl">Comprueba la descarga</h2>
      <div class="flex flex-col gap-4">
        <pre class="overflow-x-auto bg-paper p-6 font-mono text-ink"><code>shasum -a 256 Bardo-1.1.1.dmg</code></pre>
        <p class="text-ink-2">Compara el resultado con el archivo <code>.sha256</code> de la misma versión en GitHub.</p>
      </div>
    </div>
  </section>
</Layout>
