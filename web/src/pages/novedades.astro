---
import Layout from "@/layouts/main.astro"
import DownloadCta from "@/components/site/DownloadCta.astro"
import { links, release, url } from "@/lib/site"

interface Release {
  version: string
  date: string
  label: string
  groups: { name: string; items: string[] }[]
}

const releases: Release[] = [
  {
    version: "1.2.0",
    date: "2026-10-29",
    label: "29 de octubre de 2026",
    groups: [{ name: "Windows", items: ["Bardo para Windows 11, en PC x64 y ARM", "Instaladores junto al DMG en cada versión"] }],
  },
  {
    version: "1.1.4",
    date: "2026-10-29",
    label: "29 de octubre de 2026",
    groups: [
      { name: "Biblioteca", items: ["Archiva conversaciones sin borrarlas", "Selecciona varias a la vez"] },
      { name: "Grabación", items: ["La grabación en curso, en la barra de menús"] },
      { name: "Transcripción", items: ["Qué modelo transcribió cada conversación y cuánto tardó"] },
    ],
  },
  {
    version: "1.1.2",
    date: "2026-10-29",
    label: "29 de octubre de 2026",
    groups: [
      { name: "Transcripción", items: ["Ya no escribe frases sobre el silencio"] },
      { name: "Reproducción", items: ["Escucha solo a algunos participantes", "La onda está lista antes"] },
      { name: "Diseño", items: ["Los avatares del botón Participantes siguen su curva"] },
    ],
  },
  {
    version: "1.1.1",
    date: "2026-10-27",
    label: "27 de octubre de 2026",
    groups: [{ name: "Grabación", items: ["La onda en vivo se mueve al ritmo de la pantalla, hasta 120 Hz en ProMotion"] }],
  },
  {
    version: "1.1.0",
    date: "2026-10-21",
    label: "21 de octubre de 2026",
    groups: [
      {
        name: "Transcripción",
        items: ["Elige entre Rápido, Equilibrado y Preciso", "Una bienvenida en dos pasos", "Párrafos de largo cómodo", "Reproduce desde cualquier palabra"],
      },
      {
        name: "Grabación",
        items: ["Elige el micrófono y la salida", "Pausa, reanuda y silencia el micrófono", "Marca momentos y secciones", "Calidad de audio y compresión"],
      },
      { name: "Reproducción", items: ["Reproductor completo con subtítulos", "Salta los silencios"] },
      { name: "Participantes", items: ["Fusiona voces repetidas", "Avatares de colores"] },
      { name: "Corregido", items: ["El primer arranque en un Mac nuevo", "El audio del Mac con audífonos Bluetooth"] },
    ],
  },
  {
    version: "1.0.3",
    date: "2026-10-15",
    label: "15 de octubre de 2026",
    groups: [{ name: "Diseño", items: ["Los detalles de una conversación se abren en una hoja"] }],
  },
  {
    version: "1.0.2",
    date: "2026-10-15",
    label: "15 de octubre de 2026",
    groups: [{ name: "Corregido", items: ["La búsqueda ya no tapa el inspector"] }],
  },
  {
    version: "1.0.1",
    date: "2026-10-13",
    label: "13 de octubre de 2026",
    groups: [{ name: "Grabación", items: ["Graba el audio del Mac y lo transcribe aparte de tu micrófono"] }],
  },
  {
    version: "1.0.0",
    date: "2026-10-09",
    label: "9 de octubre de 2026",
    groups: [{ name: "Inicio", items: ["Primera versión"] }],
  },
]
---

<Layout
  title="Novedades de Bardo"
  description="Lo que cambió en cada versión de Bardo, la app de transcripción privada para Mac."
  current="novedades"
>
  <section class="shell pt-20 pb-12 max-lg:pt-12 max-sm:pt-8 max-sm:pb-8" aria-labelledby="page-title">
    <div class="flex flex-col gap-6">
      <h1 id="page-title" class="text-display font-heading font-semibold">Novedades</h1>
      <p class="max-w-[44ch] text-lead text-soft">
        Lo que cambió en cada versión. Las notas completas están en <a class="text-link" href={links.releases}>GitHub</a>.
      </p>
    </div>
  </section>

  <section class="shell" aria-label="Versiones">
    <ol class="border-t">
      {
        releases.map((entry) => (
          <li class="grid grid-cols-[minmax(0,4fr)_minmax(0,7fr)] gap-16 border-b py-10 max-lg:grid-cols-1 max-lg:gap-6">
            <div class="flex flex-col gap-1">
              <h2 class="text-headline tabular-nums font-heading font-semibold">{entry.version}</h2>
              <p class="text-sm text-faint">
                <time datetime={entry.date}>{entry.label}</time>
                {entry.version === release.version && <span class="text-soft"> · Versión actual</span>}
              </p>
            </div>
            <dl class="flex flex-col gap-6">
              {entry.groups.map((group) => (
                <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,5fr)] gap-6 max-sm:grid-cols-1 max-sm:gap-1">
                  <dt class="pt-px text-sm font-semibold text-faint">{group.name}</dt>
                  <dd>
                    <ul class="flex flex-col gap-2">
                      {group.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              ))}
            </dl>
          </li>
        ))
      }
    </ol>
  </section>
  <section class="shell pt-24 max-lg:pt-16 max-sm:pt-10" aria-labelledby="next-title">
    <div class="flex flex-wrap items-center justify-between gap-8 rounded-[28px] border bg-ground-2 p-12 max-sm:p-6">
      <div class="flex items-center gap-4">
        <img class="h-16 w-auto" src={url("assets/marca/bardo-mascota-ai-v2-128.webp")} width="128" height="128" alt="" loading="lazy" decoding="async" />
        <div class="flex flex-col">
          <h2 id="next-title" class="text-title">Pruébalo en tu Mac</h2>
          <p class="text-sm text-soft">Gratis y de código abierto.</p>
        </div>
      </div>
      <DownloadCta />
    </div>
  </section>
</Layout>
