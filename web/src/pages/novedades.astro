---
import Layout from "@/layouts/main.astro"
import "@/styles/pages.css"
import { links } from "@/lib/site"

interface Release {
  version: string
  date: string
  label: string
  groups: { name: string; items: string[] }[]
}

const releases: Release[] = [
  {
    version: "1.1.1",
    date: "2026-10-27",
    label: "27 de octubre de 2026",
    groups: [{ name: "Grabación", items: ["La onda en vivo se mueve al ritmo de la pantalla, hasta 120 Hz en ProMotion"] }],
  },
  {
    version: "1.1.0",
    date: "2026-10-21",
    label: "21 de octubre de 2026",
    groups: [
      {
        name: "Transcripción",
        items: ["Elige entre Rápido, Equilibrado y Preciso", "Una bienvenida en dos pasos", "Párrafos de largo cómodo", "Reproduce desde cualquier palabra"],
      },
      {
        name: "Grabación",
        items: ["Elige el micrófono y la salida", "Pausa, reanuda y silencia el micrófono", "Marca momentos y secciones", "Calidad de audio y compresión"],
      },
      { name: "Reproducción", items: ["Reproductor completo con subtítulos", "Salta los silencios"] },
      { name: "Participantes", items: ["Fusiona voces repetidas", "Avatares de colores"] },
      { name: "Corregido", items: ["El primer arranque en un Mac nuevo", "El audio del Mac con audífonos Bluetooth"] },
    ],
  },
  {
    version: "1.0.3",
    date: "2026-10-15",
    label: "15 de octubre de 2026",
    groups: [{ name: "Diseño", items: ["Los detalles de una conversación se abren en una hoja"] }],
  },
  {
    version: "1.0.2",
    date: "2026-10-15",
    label: "15 de octubre de 2026",
    groups: [{ name: "Corregido", items: ["La búsqueda ya no tapa el inspector"] }],
  },
  {
    version: "1.0.1",
    date: "2026-10-13",
    label: "13 de octubre de 2026",
    groups: [{ name: "Grabación", items: ["Graba el audio del Mac y lo transcribe aparte de tu micrófono"] }],
  },
  {
    version: "1.0.0",
    date: "2026-10-09",
    label: "9 de octubre de 2026",
    groups: [{ name: "Inicio", items: ["Primera versión"] }],
  },
]
---

<Layout
  title="Novedades de Bardo"
  description="Lo que cambió en cada versión de Bardo, la app de transcripción privada para Mac."
  current="novedades"
>
  <section class="pt-24 pb-16 max-lg:pt-16" aria-labelledby="page-title">
    <div class="shell flex flex-col gap-6">
      <h1 id="page-title" class="text-display">Novedades</h1>
      <p class="max-w-[52ch] text-lead text-ink-2">
        Lo que cambió en cada versión. Las notas completas están en <a
          class="text-link"
          href={links.releases}>GitHub</a
        >.
      </p>
    </div>
  </section>

  <section class="pb-30" aria-label="Versiones">
    <div class="shell">
      <ol class="border-t-[1.5px] border-primary">
        {
          releases.map((release) => (
            <li class="grid grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-8 border-b py-16 max-lg:grid-cols-1">
              <div class="flex flex-col gap-2">
                <h2 class="text-section">{release.version}</h2>
                <p class="text-sm text-ink-muted">
                  <time datetime={release.date}>{release.label}</time>
                </p>
              </div>
              <dl class="flex flex-col gap-12">
                {release.groups.map((group) => (
                  <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,6fr)] gap-8 max-sm:grid-cols-1 max-sm:gap-2">
                    <dt class="pt-0.5 text-sm font-medium text-ink-muted">{group.name}</dt>
                    <dd>
                      <ul class="flex flex-col gap-4 text-lead">
                        {group.items.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                ))}
              </dl>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>
