---
import { cn } from "@/lib/utils"

interface Props {
  id: string
  title: string
  text: string
  /** Puts the picture on the left. */
  flip?: boolean
  class?: string
}

const { id, title, text, flip = false, class: className } = Astro.props
---

<section class={cn("shell py-16 max-lg:py-12 max-sm:py-6", className)} aria-labelledby={id}>
  <div
    class={cn(
      "grid items-center gap-16 max-lg:grid-cols-1 max-lg:gap-10 max-sm:gap-6",
      flip ? "grid-cols-[minmax(0,7fr)_minmax(0,4fr)]" : "grid-cols-[minmax(0,4fr)_minmax(0,7fr)]"
    )}
  >
    <div class={cn("flex flex-col gap-5", flip && "lg:order-2")}>
      <h2 id={id} class="max-w-[14ch] text-headline font-heading font-semibold">{title}</h2>
      <p class="max-w-[38ch] text-lead text-soft">{text}</p>
      <slot name="aside" />
    </div>
    <div class={cn("min-w-0", flip && "lg:order-1")}>
      <slot />
    </div>
  </div>
</section>
