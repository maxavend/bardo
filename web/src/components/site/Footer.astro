---
import { links, release, requirements, url } from "@/lib/site"

const columns = [
  {
    title: "Bardo",
    items: [
      { label: "Descargar", href: url("descargar/") },
      { label: "Novedades", href: url("novedades/") },
      { label: "Privacidad", href: url("privacidad/") },
    ],
  },
  {
    title: "Proyecto",
    items: [
      { label: "Código en GitHub", href: links.repo },
      { label: "Todas las versiones", href: links.releases },
      { label: "Licencia MIT", href: links.license },
    ],
  },
]
---

<footer class="mt-24 border-t bg-ground-2 max-lg:mt-16 max-sm:mt-12">
  <div class="shell grid grid-cols-[minmax(0,5fr)_minmax(0,3fr)_minmax(0,3fr)] gap-12 py-16 max-lg:grid-cols-2 max-sm:gap-8 max-sm:py-10">
    <div class="flex flex-col items-start gap-5 max-lg:col-span-2">
      <a class="inline-flex items-center gap-3 no-underline" href={url()} aria-label="Bardo, inicio">
        <img class="h-16 w-auto" src={url("assets/marca/bardo-mascota-ai-v2-128.webp")} width="128" height="128" alt="" loading="lazy" decoding="async" />
        <span class="flex flex-col">
          <span class="font-heading text-3xl font-semibold tracking-[-0.01em] text-foreground">Bardo</span>
          <span class="text-sm text-soft">Transcripción privada para Mac</span>
        </span>
      </a>
      <p class="max-w-[38ch] text-sm text-faint">
        {requirements}. <a class="text-link whitespace-nowrap" href={url("novedades/")}>Versión {release.version}</a>, del {release.dateLabel}.
      </p>
    </div>
    {
      columns.map((column) => (
        <nav class="flex flex-col gap-3" aria-label={column.title}>
          <h2 class="text-sm font-semibold text-foreground">{column.title}</h2>
          <ul class="flex flex-col">
            {column.items.map((item) => (
              <li>
                <a
                  class="inline-flex min-h-10 items-center text-sm text-soft no-underline transition-colors duration-200 hover:text-foreground"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="shell">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line/60 py-6 text-sm text-faint">
      <p>© {new Date().getFullYear()} Maximiliano Avendaño. Todos los derechos reservados.</p>
      <p>Mac y macOS son marcas registradas de Apple Inc.</p>
    </div>
  </div>
</footer>
