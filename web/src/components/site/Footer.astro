---
import { Separator } from "@/components/ui/separator"
import { links, url } from "@/lib/site"

const footerLinks = [
  { label: "Descargar", href: url("descargar/") },
  { label: "Novedades", href: url("novedades/") },
  { label: "Privacidad", href: url("privacidad/") },
  { label: "Código en GitHub", href: links.repo },
]
---

<footer class="pt-36 pb-16 max-lg:pt-24">
  <div class="shell">
    <div class="mb-16 flex flex-col gap-2">
      <p class="max-w-[18ch] font-display text-section">Lo que se dice, por escrito.</p>
      <p class="text-ink-2">
        Maximiliano Avendaño, <time datetime="2026-10-27">27 de octubre de 2026</time>, con la versión 1.1.1.
      </p>
    </div>
    <Separator />
    <div class="flex flex-wrap items-center justify-between gap-6 pt-6">
      <ul class="flex flex-wrap gap-6">
        {
          footerLinks.map((link) => (
            <li>
              <a
                class="inline-flex min-h-11 items-center whitespace-nowrap text-ink-2 no-underline transition-colors duration-200 hover:text-ink hover:underline hover:decoration-primary"
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-sm text-ink-muted">Licencia MIT, 2026.</p>
    </div>
  </div>
</footer>
