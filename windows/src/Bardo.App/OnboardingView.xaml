<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bardo.App.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Bardo.App">

    <UserControl.Resources>
        <Style x:Key="ChoiceCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="560"
            Margin="32,24,32,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <Image
                Width="96"
                Height="96"
                HorizontalAlignment="Center"
                Source="ms-appx:///Assets/AppIcon.png" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind app:Bind.OnboardingText(ViewModel.State, 'Title'), Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind app:Bind.OnboardingText(ViewModel.State, 'Detail'), Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />

            <!--  The two ways to transcribe  -->
            <StackPanel
                Margin="0,12,0,0"
                Spacing="8"
                Visibility="{x:Bind app:Bind.Show(ViewModel.IsChoosing), Mode=OneWay}">
                <Border Style="{StaticResource ChoiceCardStyle}">
                    <RadioButton
                        x:Name="RecommendedChoice"
                        HorizontalAlignment="Stretch"
                        Checked="OnRecommendedChecked"
                        GroupName="Model"
                        IsChecked="{x:Bind ViewModel.IsRecommendedChosen, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="OnboardingRecommendedTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Border
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <TextBlock
                                        x:Uid="OnboardingRecommendedBadge"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                x:Uid="OnboardingRecommendedDetail"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.RecommendedSize}" />
                        </StackPanel>
                    </RadioButton>
                </Border>
                <Border Style="{StaticResource ChoiceCardStyle}">
                    <RadioButton
                        x:Name="PreciseChoice"
                        HorizontalAlignment="Stretch"
                        Checked="OnPreciseChecked"
                        GroupName="Model"
                        IsChecked="{x:Bind ViewModel.IsPreciseChosen, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="OnboardingPreciseTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="OnboardingPreciseDetail"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.PreciseSize}" />
                        </StackPanel>
                    </RadioButton>
                </Border>
            </StackPanel>

            <!--  The download  -->
            <StackPanel
                Margin="0,12,0,0"
                Spacing="6"
                Visibility="{x:Bind app:Bind.Show(ViewModel.ShowsProgress), Mode=OneWay}">
                <ProgressBar
                    x:Uid="OnboardingProgress"
                    Maximum="1"
                    ShowPaused="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind app:Bind.Percent(ViewModel.Progress), Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind app:Bind.Show(ViewModel.HasFailed), Mode=OneWay}" />

            <!--  What can be done now  -->
            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Uid="OnboardingDownloadButton"
                    MinWidth="140"
                    Click="OnDownload"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind app:Bind.Show(ViewModel.IsChoosing), Mode=OneWay}" />
                <Button
                    x:Uid="OnboardingResumeButton"
                    MinWidth="140"
                    Click="OnDownload"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind app:Bind.Show(ViewModel.IsPaused), Mode=OneWay}" />
                <Button
                    x:Uid="OnboardingRetryButton"
                    MinWidth="140"
                    Click="OnDownload"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind app:Bind.Show(ViewModel.HasFailed), Mode=OneWay}" />
                <Button
                    x:Uid="OnboardingStartButton"
                    MinWidth="140"
                    Click="OnClose"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind app:Bind.Show(ViewModel.IsReady), Mode=OneWay}" />
                <Button
                    x:Uid="OnboardingUseMeanwhileButton"
                    Click="OnClose"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind app:Bind.Show(ViewModel.IsDownloading), Mode=OneWay}" />
                <Button
                    x:Uid="OnboardingPauseButton"
                    Click="OnPause"
                    Visibility="{x:Bind app:Bind.Show(ViewModel.IsDownloading), Mode=OneWay}" />
                <Button
                    x:Uid="OnboardingSkipButton"
                    Click="OnClose"
                    Visibility="{x:Bind app:Bind.ShowEither(ViewModel.IsChoosing, ViewModel.HasFailed), Mode=OneWay}" />
                <Button
                    x:Uid="OnboardingSkipButtonPaused"
                    Click="OnClose"
                    Visibility="{x:Bind app:Bind.Show(ViewModel.IsPaused), Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                x:Uid="OnboardingPrivacy"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
