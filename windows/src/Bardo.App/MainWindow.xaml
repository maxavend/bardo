<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bardo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Bardo.App"
    xmlns:capture="using:Bardo.Capture"
    xmlns:controls="using:Bardo.App.Controls"
    xmlns:library="using:Bardo.Library"
    Title="Bardo">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Bardo"
            IsPaneToggleButtonVisible="{x:Bind app:Bind.Not(Onboarding.IsOpen), Mode=OneWay}"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="LibrarySearch"
                    MinWidth="240"
                    MaxWidth="400"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    TextChanged="OnSearchTextChanged"
                    Visibility="{x:Bind app:Bind.Hide(Onboarding.IsOpen), Mode=OneWay}" />
            </TitleBar.Content>
        </TitleBar>

        <app:OnboardingView
            x:Name="OnboardingContent"
            Grid.Row="1"
            ViewModel="{x:Bind Onboarding}"
            Visibility="{x:Bind app:Bind.Show(Onboarding.IsOpen), Mode=OneWay}" />

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            Visibility="{x:Bind app:Bind.Hide(Onboarding.IsOpen), Mode=OneWay}"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="OnSectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader x:Uid="LibraryHeader" />
                <NavigationViewItem x:Uid="SectionAll" IsSelected="True" Tag="All">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SectionRecorded" Tag="Recorded">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE720;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SectionImported" Tag="Imported">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SectionFavorites" Tag="Favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="16,8,16,0" Spacing="8">
                    <InfoBar
                        x:Name="NoticeBar"
                        IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                        Message="{x:Bind app:Bind.Message(ViewModel.Notice), Mode=OneWay}"
                        Severity="{x:Bind app:Bind.Severity(ViewModel.Notice), Mode=OneWay}"
                        CloseButtonClick="OnNoticeClosed" />
                    <StackPanel x:Name="LibraryNotices" Spacing="8">
                    <InfoBar
                        x:Name="RecoveryBar"
                        x:Uid="RecoveryBar"
                        IsOpen="False"
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button x:Uid="RecoverButton" Click="OnRecoverCaptures" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        x:Name="SetupBar"
                        x:Uid="SetupBar"
                        IsClosable="True"
                        IsOpen="{x:Bind Settings.IsTranscriptionMissing, Mode=OneWay}"
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button x:Uid="SetupButton" Click="OnOpenSettings" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        x:Uid="IssuesBar"
                        IsOpen="{x:Bind ViewModel.HasIssues, Mode=OneWay}"
                        Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button x:Uid="IssuesOpenFolderButton" Click="OnOpenLibraryFolder" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    </StackPanel>
                </StackPanel>

                <!--  Library  -->
                <Grid
                    x:Name="LibraryContent"
                    Grid.Row="1"
                    Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Padding="16,0,16,8"
                            Orientation="Horizontal"
                            Spacing="8">
                            <DropDownButton x:Name="RecordButton" IsEnabled="{x:Bind app:Bind.Not(Recorder.IsRecording), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE7C8;" />
                                    <TextBlock x:Uid="RecordText" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem x:Uid="RecordMicrophone" Click="OnRecord" Tag="Microphone">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE720;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="RecordSystemAudio" Click="OnRecord" Tag="SystemAudio">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7F4;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="RecordMeeting" Click="OnRecord" Tag="Meeting">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE716;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Click="OnImport">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8B5;" />
                                    <TextBlock x:Uid="ImportText" />
                                </StackPanel>
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                            </Button>
                            <DropDownButton x:Uid="SortButton">
                                <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedLeft">
                                        <RadioMenuFlyoutItem x:Uid="SortNewest" Click="OnSort" GroupName="Sort" Tag="Newest" />
                                        <RadioMenuFlyoutItem x:Uid="SortOldest" Click="OnSort" GroupName="Sort" Tag="Oldest" />
                                        <RadioMenuFlyoutItem x:Uid="SortName" Click="OnSort" GroupName="Sort" Tag="Name" />
                                        <RadioMenuFlyoutItem x:Uid="SortDuration" Click="OnSort" GroupName="Sort" Tag="Duration" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <ListView
                            x:Name="RecordingList"
                            x:Uid="RecordingList"
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.Rows}"
                            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
                            SelectionChanged="OnRecordingSelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="library:RecordingRow">
                                    <Grid Padding="0,10" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Title}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Details}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <FontIcon
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            FontSize="12"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE735;"
                                            Visibility="{x:Bind app:Bind.Show(IsFavorite)}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            Grid.Row="1"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind app:Bind.Show(ViewModel.IsLibraryEmpty), Mode=OneWay}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8D6;" />
                            <TextBlock
                                x:Uid="EmptyLibraryTitle"
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Uid="EmptyLibraryBody"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <TextBlock
                            x:Uid="FilterEmptyText"
                            Grid.Row="1"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind app:Bind.Show(ViewModel.IsFilterEmpty), Mode=OneWay}" />
                    </Grid>

                    <!--  The selected conversation, or the recorder  -->
                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="8,0,0,0">
                        <Grid>

                            <TextBlock
                                x:Uid="NoSelectionText"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind app:Bind.ShowUnless(ViewModel.HasNoSelection, Recorder.IsRecording), Mode=OneWay}" />

                            <!--  Hidden while recording: the recorder takes the whole pane.  -->
                            <Grid Visibility="{x:Bind app:Bind.ShowUnless(ViewModel.HasSelection, Recorder.IsRecording), Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollViewer>
                                    <StackPanel
                                        MaxWidth="760"
                                        Padding="40,28,40,48"
                                        Spacing="4">
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource TitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.SelectedDetails, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />

                                        <CommandBar
                                            Margin="-12,8,0,0"
                                            HorizontalAlignment="Left"
                                            DefaultLabelPosition="Right"
                                            IsDynamicOverflowEnabled="True">
                                            <AppBarButton
                                                x:Uid="TranscribeButton"
                                                Click="OnTranscribe"
                                                IsEnabled="{x:Bind ViewModel.CanTranscribeSelected, Mode=OneWay}">
                                                <AppBarButton.Icon>
                                                    <FontIcon Glyph="&#xE8D2;" />
                                                </AppBarButton.Icon>
                                            </AppBarButton>
                                            <AppBarButton
                                                x:Uid="IdentifySpeakersButton"
                                                Click="OnIdentifySpeakers"
                                                IsEnabled="{x:Bind ViewModel.CanIdentifySpeakers, Mode=OneWay}">
                                                <AppBarButton.Icon>
                                                    <FontIcon Glyph="&#xE716;" />
                                                </AppBarButton.Icon>
                                            </AppBarButton>
                                            <AppBarButton
                                                x:Uid="CopyTranscriptButton"
                                                Click="OnCopyTranscript"
                                                IsEnabled="{x:Bind ViewModel.HasTranscript, Mode=OneWay}">
                                                <AppBarButton.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </AppBarButton.Icon>
                                                <AppBarButton.KeyboardAccelerators>
                                                    <KeyboardAccelerator Key="C" Modifiers="Control,Shift" />
                                                </AppBarButton.KeyboardAccelerators>
                                            </AppBarButton>
                                            <AppBarToggleButton
                                                x:Uid="FavoriteButton"
                                                Click="OnToggleFavorite"
                                                IsChecked="{x:Bind ViewModel.IsSelectedFavorite, Mode=OneWay}">
                                                <AppBarToggleButton.Icon>
                                                    <FontIcon Glyph="{x:Bind app:Bind.Star(ViewModel.IsSelectedFavorite), Mode=OneWay}" />
                                                </AppBarToggleButton.Icon>
                                            </AppBarToggleButton>
                                            <CommandBar.SecondaryCommands>
                                                <AppBarButton x:Uid="RenameButton" Click="OnRename">
                                                    <AppBarButton.Icon>
                                                        <FontIcon Glyph="&#xE8AC;" />
                                                    </AppBarButton.Icon>
                                                    <AppBarButton.KeyboardAccelerators>
                                                        <KeyboardAccelerator Key="F2" />
                                                    </AppBarButton.KeyboardAccelerators>
                                                </AppBarButton>
                                                <AppBarButton x:Uid="ShowInFolderButton" Click="OnShowInFolder">
                                                    <AppBarButton.Icon>
                                                        <FontIcon Glyph="&#xE838;" />
                                                    </AppBarButton.Icon>
                                                </AppBarButton>
                                                <AppBarSeparator />
                                                <AppBarButton x:Uid="RecycleButton" Click="OnRecycle">
                                                    <AppBarButton.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </AppBarButton.Icon>
                                                    <AppBarButton.KeyboardAccelerators>
                                                        <KeyboardAccelerator Key="Delete" />
                                                    </AppBarButton.KeyboardAccelerators>
                                                </AppBarButton>
                                            </CommandBar.SecondaryCommands>
                                        </CommandBar>

                                        <!--  Transcribing or identifying speakers  -->
                                        <Grid
                                            Margin="0,12,0,0"
                                            ColumnSpacing="12"
                                            Visibility="{x:Bind app:Bind.Show(ViewModel.IsSelectedWorking), Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind ViewModel.WorkDescription, Mode=OneWay}" />
                                                <ProgressBar Maximum="1" Value="{x:Bind ViewModel.WorkProgress, Mode=OneWay}" />
                                            </StackPanel>
                                            <Button
                                                x:Uid="CancelWorkButton"
                                                Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                Click="OnCancelWork" />
                                        </Grid>

                                        <StackPanel
                                            Margin="0,28,0,0"
                                            Spacing="4"
                                            Visibility="{x:Bind app:Bind.Show(ViewModel.HasNoTranscript), Mode=OneWay}">
                                            <TextBlock x:Uid="NoTranscriptTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                x:Uid="NoTranscriptBody"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>

                                        <!--  Participants  -->
                                        <Expander
                                            x:Name="ParticipantsExpander"
                                            Margin="0,20,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Visibility="{x:Bind app:Bind.Show(ViewModel.HasSpeakers), Mode=OneWay}">
                                            <Expander.Header>
                                                <TextBlock x:Uid="ParticipantsHeader" />
                                            </Expander.Header>
                                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Speakers}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="library:SpeakerRow">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse
                                                                Width="10"
                                                                Height="10"
                                                                VerticalAlignment="Center"
                                                                Fill="{x:Bind app:Bind.SpeakerBrush(Index)}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Text="{x:Bind DisplayName}"
                                                                TextWrapping="WrapWholeWords" />
                                                            <Button
                                                                x:Uid="SpeakerActionsButton"
                                                                Grid.Column="2"
                                                                Click="OnSpeakerActions"
                                                                Style="{StaticResource SubtleButtonStyle}"
                                                                Tag="{x:Bind Id}">
                                                                <FontIcon FontSize="16" Glyph="&#xE712;" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </Expander>

                                        <!--  Transcript  -->
                                        <ItemsRepeater Margin="0,8,0,0" ItemsSource="{x:Bind ViewModel.Blocks}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="library:TranscriptBlockRow">
                                                    <StackPanel Padding="0,20,0,0" Spacing="4">
                                                        <!--  The section this turn starts  -->
                                                        <StackPanel
                                                            Margin="0,12,0,8"
                                                            Orientation="Horizontal"
                                                            Spacing="10"
                                                            Visibility="{x:Bind app:Bind.Show(HasSection)}">
                                                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Section}" TextWrapping="WrapWholeWords" />
                                                            <TextBlock
                                                                Margin="0,0,0,3"
                                                                VerticalAlignment="Bottom"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind SectionTime}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <!--  The participant's colour, as in the waveform.  -->
                                                            <Ellipse
                                                                Width="8"
                                                                Height="8"
                                                                VerticalAlignment="Center"
                                                                Fill="{x:Bind app:Bind.SpeakerBrush(SpeakerIndex)}"
                                                                Visibility="{x:Bind app:Bind.Show(HasSpeaker)}" />
                                                            <HyperlinkButton
                                                                Padding="0"
                                                                Click="OnPlayFromBlock"
                                                                Tag="{x:Bind Start}">
                                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Heading}" />
                                                            </HyperlinkButton>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind Time}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            IsTextSelectionEnabled="True"
                                                            Style="{StaticResource BodyTextBlockStyle}"
                                                            Text="{x:Bind Text}"
                                                            TextWrapping="Wrap" />
                                                        <!--  Moments marked during this turn  -->
                                                        <ItemsRepeater
                                                            Margin="0,8,0,0"
                                                            ItemsSource="{x:Bind Moments}"
                                                            Visibility="{x:Bind app:Bind.Show(HasMoments)}">
                                                            <ItemsRepeater.Layout>
                                                                <StackLayout Spacing="6" />
                                                            </ItemsRepeater.Layout>
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate x:DataType="library:MomentRow">
                                                                    <Grid
                                                                        Padding="14,10"
                                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        ColumnSpacing="12"
                                                                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <FontIcon
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,2,0,0"
                                                                            FontSize="16"
                                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                            Glyph="&#xE7C1;" />
                                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="WrapWholeWords" />
                                                                                <TextBlock
                                                                                    VerticalAlignment="Center"
                                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                                    Text="{x:Bind Time}" />
                                                                            </StackPanel>
                                                                            <TextBlock
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Text="{x:Bind Note}"
                                                                                TextWrapping="WrapWholeWords"
                                                                                Visibility="{x:Bind app:Bind.Show(HasNote)}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </ScrollViewer>

                                <!--  Playback  -->
                                <Grid
                                    Grid.Row="1"
                                    Padding="24,10"
                                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    ColumnSpacing="12"
                                    Visibility="{x:Bind app:Bind.Show(Playback.IsAvailable), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Uid="SkipBackButton" Click="OnSkipBack">
                                        <FontIcon FontSize="16" Glyph="&#xED3C;" />
                                    </Button>
                                    <Button
                                        x:Uid="PlayButton"
                                        Grid.Column="1"
                                        Click="OnTogglePlay"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <FontIcon FontSize="16" Glyph="{x:Bind Playback.PlayGlyph, Mode=OneWay}" />
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="P" Modifiers="Control" />
                                        </Button.KeyboardAccelerators>
                                    </Button>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Playback.PositionText, Mode=OneWay}" />
                                    <controls:WaveformView
                                        x:Name="PlaybackWaveform"
                                        x:Uid="PlaybackWaveform"
                                        Grid.Column="3"
                                        Height="40"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Playback.DurationText, Mode=OneWay}" />
                                </Grid>
                            </Grid>

                            <!--  Live recorder  -->
                            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Visibility="{x:Bind app:Bind.Show(Recorder.IsRecording), Mode=OneWay}">
                                <StackPanel
                                    MaxWidth="560"
                                    Margin="40"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Spacing="20">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource DisplayTextBlockStyle}"
                                        Text="{x:Bind Recorder.ElapsedText, Mode=OneWay}" />
                                    <TextBlock
                                        x:Uid="PausedText"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind app:Bind.Show(Recorder.IsPaused), Mode=OneWay}" />

                                    <StackPanel Spacing="8">
                                        <controls:WaveformView
                                            x:Name="LiveWaveform"
                                            x:Uid="LiveWaveform"
                                            Height="120"
                                            IsTabStop="False" />
                                        <!--  In a meeting, which colour is which source.  -->
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="16"
                                            Visibility="{x:Bind app:Bind.ShowBoth(Recorder.HasMicrophone, Recorder.HasSystemAudio), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    Fill="{x:Bind app:Bind.SourceBrush(x:False)}" />
                                                <TextBlock x:Uid="MicrophoneLevelText" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    Fill="{x:Bind app:Bind.SourceBrush(x:True)}" />
                                                <TextBlock x:Uid="SystemLevelText" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ToggleButton
                                            x:Uid="PauseRecordingButton"
                                            Click="OnTogglePauseRecording"
                                            IsChecked="{x:Bind Recorder.IsPaused, Mode=OneWay}">
                                            <FontIcon FontSize="16" Glyph="&#xE769;" />
                                        </ToggleButton>
                                        <ToggleButton
                                            x:Uid="MuteButton"
                                            Click="OnToggleMute"
                                            IsChecked="{x:Bind Recorder.IsMicrophoneMuted, Mode=OneWay}"
                                            Visibility="{x:Bind app:Bind.Show(Recorder.HasMicrophone), Mode=OneWay}">
                                            <FontIcon FontSize="16" Glyph="&#xF781;" />
                                        </ToggleButton>
                                        <Button x:Uid="MomentButton" Click="OnAddMoment">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="16" Glyph="&#xE7C1;" />
                                                <TextBlock x:Uid="MomentText" />
                                            </StackPanel>
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="M" Modifiers="Control" />
                                            </Button.KeyboardAccelerators>
                                        </Button>
                                        <Button x:Uid="SectionButton" Click="OnAddSection">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="16" Glyph="&#xE8A4;" />
                                                <TextBlock x:Uid="SectionText" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!--  Stop stands apart, like the Sound Recorder's main button.  -->
                                    <Button
                                        MinWidth="160"
                                        HorizontalAlignment="Center"
                                        Click="OnStopRecording"
                                        IsEnabled="{x:Bind app:Bind.Not(Recorder.IsFinishing), Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE71A;" />
                                            <TextBlock x:Uid="StopText" />
                                        </StackPanel>
                                    </Button>
                                    <ProgressRing
                                        HorizontalAlignment="Center"
                                        IsActive="{x:Bind Recorder.IsFinishing, Mode=OneWay}" />

                                    <ItemsRepeater ItemsSource="{x:Bind Recorder.Marks}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="capture:MarkRow">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Time}" />
                                                    <TextBlock Text="{x:Bind Title}" TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!--  Settings  -->
                <app:SettingsView
                    x:Name="SettingsContent"
                    Grid.Row="1"
                    ViewModel="{x:Bind Settings}"
                    Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
